# =====================================================================
# .env.example — THE TEMPLATE. Commit this file.
#
# This file has placeholder values only, so it is safe in Git. It is
# what tells a teammate which variables the app needs.
#
# First thing to do after cloning this repo:
#
#     cp .env.example .env        (macOS / Linux)
#     copy .env.example .env      (Windows CMD)
#     Copy-Item .env.example .env (Windows PowerShell)
#
# Then open your new .env and put YOUR OWN values in. Your .env is
# git-ignored (see .gitignore), so it never gets committed and never
# overwrites anyone else's.
#
# Why the real values are not in Git: anything committed stays in the
# repository's history permanently. Deleting it in a later commit does
# not remove it — `git log -p` still shows it, and so does every clone
# anyone has already made. A leaked Azure client secret or Gmail App
# Password has to be revoked and regenerated, not just deleted.
#
# The values are also DIFFERENT for each of you: your MySQL password is
# not your teammate's. One shared .env would break everyone's setup.
#
# If a teammate needs a value that genuinely IS shared (the Azure
# client secret, for example), send it through a password manager's
# shared vault — not chat, not email, not a file in the repo.
# =====================================================================


# --- Microsoft login (Azure AD app registration) ---
# From Azure Portal -> App registrations -> your app.
# Client ID and Tenant ID are not secret on their own (they appear in
# ordinary OAuth traffic). The client SECRET is the one that matters.
# Not needed at all if you only use DEV_MODE login below.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret-value-here
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Only needed if you are not using the defaults (http://localhost:5000/...)
# AZURE_REDIRECT_URI=http://localhost:5000/auth/callback
# AZURE_POST_LOGOUT_REDIRECT_URI=http://localhost:5000/

# --- Dev login bypass (see auth/server.py) ---
# Set to 1 to skip Microsoft login entirely while developing locally.
# NEVER set this anywhere publicly reachable — it lets anyone sign in
# as any role with no credentials at all.
DEV_MODE=1

# --- Email approval system (Gmail via Flask-Mail) ---
# MAIL_PASSWORD must be a 16-character Google App Password, NOT your
# normal Gmail password. Create one at:
#   Google Account -> Security -> 2-Step Verification -> App passwords
# Leave these blank and the Request a Change form will tell you the
# mail account is not configured, rather than failing silently.
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx

# --- Database (MySQL) ---
# DB_USER / DB_PASSWORD are whatever you log into MySQL Workbench with.
# DB_NAME must match the database created by
# "SPI Unit Outline Systems.sql" — run that script first.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=SpiUnitOutlines

# --- Public base URL for links inside emails ---
# The Approve/Reject buttons in approval emails point here. Leave it
# unset for local testing (defaults to http://127.0.0.1:5000); set it
# to the real address once this is hosted somewhere, otherwise those
# links only work on the machine running the server.
# APP_BASE_URL=https://your-host.example.com

# --- Flask session signing ---
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-random-string
