# Copy this file to .env and fill in real values.
# .env itself is git-ignored (see .gitignore) — never commit real
# credentials. This file (.env.example) has placeholders only, so it's
# safe to commit and share with the team.

# --- Microsoft login (Azure AD app registration) ---
# From Azure Portal -> App registrations -> your app
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Only needed if not using the defaults (http://localhost:5000/...)
# AZURE_REDIRECT_URI=http://localhost:5000/auth/callback
# AZURE_POST_LOGOUT_REDIRECT_URI=http://localhost:5000/

# --- Dev login bypass (see auth/server.py) ---
# Set to 1 to skip Microsoft login entirely during local development.
# NEVER set this in production / anywhere publicly reachable.
DEV_MODE=1

# --- Email approval system (Gmail via Flask-Mail) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Database (MySQL) ---
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Flask session signing ---
# Any random string. Only matters if Flask's own session cookie
# mechanism gets used somewhere (the Microsoft-login session store in
# login.py doesn't need it, but Flask itself expects SECRET_KEY set).
SECRET_KEY=dev-only-change-me
